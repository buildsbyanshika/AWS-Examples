#!/usr/bin/env bash

echo "===Create Bucket==="



if [ -z "$1" ]; then
    echo "Error: Bucket name is required!"
    exit 1
else
    echo "Bucket name entered: $BUCKET_NAME"
fi

BUCKET_NAME=$1

aws s3api create-bucket \
--bucket $BUCKET_NAME \
--region ap-southeast-2 \
--create-bucket-configuration "LocationConstraint=ap-southeast-2" \
