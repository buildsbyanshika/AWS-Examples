#!/usr/bin/env bash



echo "===list obejct in Bucket==="


if [ -z "$1" ]; then
    echo "Error: Bucket name is required!"
    exit 1
else
    echo "Bucket name entered: $BUCKET_NAME"
fi

BUCKET_NAME=$1

aws s3api list-objects-v2 --bucket $BUCKET_NAME --output text --query 'Contents[].[Key, LastModified]'
